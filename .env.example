NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:sudu@localhost:5435/prumo?schema=public"
DATABASE_URL_TEST="postgresql://postgres:sudu@localhost:5435/prumo_test?schema=public"
JWT_ACCESS_SECRET=<256-bits-em-base64>
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
RESET_TTL_MINUTES=30
WEBHOOK_SECRET="dev_webhook_secret_0123456789abcdef"
APP_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="prumo-uploads"
S3_ACCESS_KEY_ID="dev"
S3_SECRET_ACCESS_KEY="dev_secret"
# Social login (opcional). Quando ausente, o endpoint /auth/oauth correspondente retorna 503.
# Google: OAuth 2.0 Client ID (tipo "Web") do Google Cloud Console.
GOOGLE_CLIENT_ID=""
# Apple: Services ID (clientId) do "Sign in with Apple".
APPLE_CLIENT_ID=""
